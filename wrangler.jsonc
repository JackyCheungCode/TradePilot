{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradepilot",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "tradepilot-lead-discovery",
      "binding": "LEAD_DISCOVERY_WORKFLOW",
      "class_name": "LeadDiscoveryWorkflow"
    }
  ]
}
