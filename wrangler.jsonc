{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradepilot",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "tradepilot-lead-discovery",
      "binding": "LEAD_DISCOVERY_WORKFLOW",
      "class_name": "LeadDiscoveryWorkflow"
    }
  ],
  "account_id": "ea4e98dce9c478d7dd5c07f10e5c722d",
  "vars": {
    "SUPABASE_URL": "https://nlklnkkcwapwerkahoyb.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_9jPg2Sv0VmMho3vOvxU00Q_-kWg8xw_"
  }
}
